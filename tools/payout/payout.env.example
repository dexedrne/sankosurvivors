# LOCAL CLI ONLY. Vercel uses dashboard variables documented in README.md.
# Write your own file outside the repository; chmod 600. Never commit real values.
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_KEY=YOUR_PUBLISHABLE_KEY
REPORTS_KEY=YOUR_REPORTS_KEY
PAYOUT_KEY=YOUR_NEW_PAYOUT_KEY
TG_BOT_TOKEN=YOUR_BOT_TOKEN
TG_CHAT_ID=YOUR_CHAT_ID
PAYOUT_LIVE=0
WEEK_DMT_CAP=1000
TRANSFER_DMT_CAP=500
ETH_RUN_CAP=0.005
MAX_FEE_GWEI=2
# Choose ONE of the following sources, only needed in live mode:
# WALLET_PRIVATE_KEY=0xYOUR_ENTRY_WALLET_PRIVATE_KEY
# KEYSTORE_PATH=/absolute/path/entry-wallet.json
# KEYSTORE_PASSPHRASE_FILE=/absolute/path/keystore-password
