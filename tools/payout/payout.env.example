# The owner's laptop only: payouts are never run on Vercel or a job box. Write your own file at
# ~/.config/sankosurvivors/payout.env, outside the repository; chmod 600. Never commit real values.
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_KEY=YOUR_PUBLISHABLE_KEY
REPORTS_KEY=YOUR_REPORTS_KEY
PAYOUT_KEY=YOUR_NEW_PAYOUT_KEY
TG_BOT_TOKEN=YOUR_BOT_TOKEN
TG_CHAT_ID=YOUR_CHAT_ID
PAYOUT_LIVE=0
WEEK_DMT_CAP=1000
TRANSFER_DMT_CAP=500
ETH_RUN_CAP=0.005
MAX_FEE_GWEI=2
# The entry wallet's encrypted Web3 v3 keystore and its passphrase file (both mode 600), needed only in live mode.
# A raw wallet key is refused.
# Absolute paths (no ~); tools/payout/check-keystore.mjs checks these two files:
# KEYSTORE_PATH=/home/YOU/Documents/sankosurvivors/ranked-wallet-keystore.json
# KEYSTORE_PASSPHRASE_FILE=/home/YOU/.config/sankosurvivors/ranked-wallet.passphrase
